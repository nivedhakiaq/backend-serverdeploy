pipeline {
  agent any
  environment {
    EC2 = 'ubuntu@43.204.231.120'
  }
  stages {
    stage('Checkout') {
      steps {
        git branch: 'main', url: 'https://github.com/nivedhakiaq/backend-serverdeploy.git', credentialsId: 'github-creds'
      }
    }
    stage('Deploy') {
      steps {
        sshagent(['backend-ssh']) {
          sh '''
            ssh -o StrictHostKeyChecking=no $EC2 "mkdir -p ~/backend"
            scp -o StrictHostKeyChecking=no -r ./* $EC2:~/backend/
            ssh -o StrictHostKeyChecking=no $EC2 "cd ~/backend && docker build -t backend . && (docker rm -f backend || true) && docker run -d --name backend -p 5000:5000 backend"
          '''
        }
      }
    }
  }
} 
